  _tutorialDialogs:
  - step: 1
    explainationSprite_EN: {fileID: 0}
    explainationSprite_JP: {fileID: 0}
    explainationText_EN: "Let\u2019s begin your new maid training!"
    explainationText_JP: "\u65B0\u4EBA\u30E1\u30A4\u30C9\u306E\u7814\u4FEE\u3092\u59CB\u3081\u308B\u3088\uFF01"
  - step: 2
    explainationSprite_EN: {fileID: 21300000, guid: ec0bf966a3a5fc84db0054a2b7e9d807, type: 3}
    explainationSprite_JP: {fileID: 21300000, guid: b60412c02e44fdc4cb1bb729a3518c46, type: 3}
    explainationText_EN: First, the screen explanation! Earn as many points as you
      can before the timer in the top-left reaches 0!
    explainationText_JP: "\u307E\u305A\u306F\u753B\u9762\u8AAC\u660E\uFF01\u5DE6\u4E0A\u306E\u30BF\u30A4\u30DE\u30FC\u304C0\u306B\u306A\u308B\u307E\u3067\u306B\u6CA2\u5C71\u70B9\u3092\u7A3C\u3054\u3046\uFF01"
  - step: 3
    explainationSprite_EN: {fileID: 0}
    explainationSprite_JP: {fileID: 0}
    explainationText_EN: 'Next, practice time! Use the mouse to draw on the pancake
      following the example!

      The number in the bottom-left shows how many
      times you can draw!'
    explainationText_JP: "\u6B21\u306B\u5B9F\u8DF5\uFF01\u30D1\u30F3\u30B1\u30FC\u30AD\u306B\u30DE\u30A6\u30B9\u3067\u304A\u624B\u672C\u306B\u305D\u3063\u3066\u7D75\u3092\u304B\u3044\u3066\u307F\u3066\u306D\uFF01\r\n\u5DE6\u4E0B\u306F\u304B\u3051\u308B\u56DE\u6570\u3060\u3088\uFF01"
  - step: 4
    explainationSprite_EN: {fileID: 21300000, guid: 9e99ea08b8eb7f344b0cefb280c9840b, type: 3}
    explainationSprite_JP: {fileID: 21300000, guid: 9e99ea08b8eb7f344b0cefb280c9840b, type: 3}
    explainationText_EN: "Now face the screen and say \u201CMoe Moe Kyun!\u201D Make
      a heart shape with your hands and show it to the camera!\nAnd say \u201CMoe
      Moe Kyun!\u201D in a loud voice!!"
    explainationText_JP: "\u753B\u9762\u306B\u5411\u304B\u3063\u3066\u840C\u3048\u840C\u3048\u30AD\u30E5\u30F3\uFF01\u624B\u3092\u30CF\u30FC\u30C8\u306B\u3057\u3066\u30AB\u30E1\u30E9\u306B\u5411\u3051\u3066\u306D\uFF01\r\n\u5927\u304D\u306A\u58F0\u3067\u840C\u3048\u840C\u3048\u30AD\u30E5\u30F3\uFF01\u3068\u8A00\u304A\u3046\uFF01\uFF01"
  - step: 5
    explainationSprite_EN: {fileID: 21300000, guid: 2b7e2589f4ab663449195ad5781461ea, type: 3}
    explainationSprite_JP: {fileID: 21300000, guid: 2b7e2589f4ab663449195ad5781461ea, type: 3}
    explainationText_EN: "If you do a good job with both the omurice drawing and
      the Moe Moe Kyun, you\u2019ll get a high score!\nYou might even enter a score
      bonus Fever Time...!?"
    explainationText_JP: "\u30AA\u30E0\u30E9\u30A4\u30B9\u306E\u30A4\u30E9\u30B9\u30C8\u3068\u840C\u3048\u840C\u3048\u30AD\u30E5\u30F3\u304C\u3046\u307E\u304F\u3067\u304D\u308B\u3068\u9AD8\u5F97\u70B9\uFF01\u70B9\u6570\u30A2\u30C3\u30D7\u306E\u30D5\u30A3\u30FC\u30D0\u30FC\u30BF\u30A4\u30E0\u306B\u5165\u308C\u308B\u304B\u3082...\uFF1F"
  - step: 6
    explainationSprite_EN: {fileID: 0}
    explainationSprite_JP: {fileID: 0}
    explainationText_EN: "That\u2019s the end of your maid training! Time for the
      real thing!!"
    explainationText_JP: "\u3053\u308C\u3067\u65B0\u4EBA\u7814\u4FEE\u306F\u7D42\u308F\u308A\uFF01\u672C\u756A\u3044\u304F\u3088\u30FC\uFF01\uFF01"
  _goNextSceneDelay: 1
