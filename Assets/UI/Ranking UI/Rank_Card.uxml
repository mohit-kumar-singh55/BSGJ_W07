<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="RankCard" style="flex-grow: 1; width: 100%; height: auto; flex-direction: row; align-items: center; justify-content: space-between; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; font-size: 14px;">
        <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
            <ui:Label text="1" name="RankNo" style="font-size: 120px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/%E3%81%AB%E3%81%8F%E3%81%BE%E3%82%8B%E3%83%95%E3%82%A9%E3%83%B3%E3%83%88/%E3%81%9D%E3%81%AE%E4%BB%96%E3%83%95%E3%82%A1%E3%82%A4%E3%83%AB%EF%BC%88%E3%82%B5%E3%83%9D%E3%83%BC%E3%83%88%E5%A4%96%EF%BC%89/07%E3%81%AB%E3%81%8F%E3%81%BE%E3%82%8B%E3%83%95%E3%82%A9%E3%83%B3%E3%83%88.ttf?fileID=12800000&amp;guid=c91bcb31496a3b84ca237724e147fdff&amp;type=3#07にくまるフォント&quot;); color: rgb(255, 115, 156); -unity-text-outline-width: 3px; -unity-text-outline-color: rgb(154, 62, 62); width: 250px;">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="RankNo" binding-mode="ToTarget"/>
                </Bindings>
            </ui:Label>
            <ui:Label text="shin mks" name="Name" style="font-size: 120px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Examples%20&amp;%20Extras/Fonts/Bangers.ttf?fileID=12800000&amp;guid=5dd49b3eacc540408c98eee0de38e0f1&amp;type=3#Bangers&quot;); color: rgb(255, 255, 255); -unity-text-outline-width: 8px; -unity-text-outline-color: rgb(255, 115, 156); letter-spacing: 8px;">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="Name" binding-mode="ToTarget"/>
                </Bindings>
            </ui:Label>
        </ui:VisualElement>
        <ui:Label text="0000" name="Score" double-click-selects-word="false" triple-click-selects-line="false" display-tooltip-when-elided="true" style="font-size: 120px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/%E3%81%AB%E3%81%8F%E3%81%BE%E3%82%8B%E3%83%95%E3%82%A9%E3%83%B3%E3%83%88/%E3%81%9D%E3%81%AE%E4%BB%96%E3%83%95%E3%82%A1%E3%82%A4%E3%83%AB%EF%BC%88%E3%82%B5%E3%83%9D%E3%83%BC%E3%83%88%E5%A4%96%EF%BC%89/07%E3%81%AB%E3%81%8F%E3%81%BE%E3%82%8B%E3%83%95%E3%82%A9%E3%83%B3%E3%83%88.ttf?fileID=12800000&amp;guid=c91bcb31496a3b84ca237724e147fdff&amp;type=3#07にくまるフォント&quot;); color: rgb(255, 115, 156); -unity-text-outline-width: 5px; -unity-text-outline-color: rgb(221, 83, 83); text-overflow: ellipsis; letter-spacing: 2px;">
            <Bindings>
                <ui:DataBinding property="text" data-source-path="Score" binding-mode="ToTarget"/>
            </Bindings>
        </ui:Label>
    </ui:VisualElement>
</ui:UXML>
